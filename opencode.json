{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git checkout*": "deny"
    }
  },
  "formatter": {
    "prettier": {
      "enabled": true
    }
  },
  "linter": {
    "eslint": {
      "enabled": true
    }
  }
}
